<?php

namespace {{namespace}};

use SPP\Core\Workflow\WizardController;

/**
 * Class {{className}}
 * Handles the multi-step {{wizardName}} wizard process.
 */
class {{className}} extends WizardController
{
    protected string $workflowName = '{{wizardName}}';
    protected string $entityType = '{{wizardName}}';
    protected string $bundle = 'default';

    /**
     * Retrieve the active wizard entity (e.g. from session or database).
     * @return object
     */
    protected function getWizardEntity()
    {
        // Example: load from session
        if (!isset($_SESSION['wizard_{{wizardName}}'])) {
            $entity = new \stdClass();
            \SPPMod\SPPWorkflow\SPPWorkflowManager::applyTransition($entity, 'draft', null, 'Initial stub setup');
            $_SESSION['wizard_{{wizardName}}'] = $entity;
        }
        return $_SESSION['wizard_{{wizardName}}'];
    }

    /**
     * Save the active wizard entity state.
     * @param object $entity
     */
    protected function saveWizardEntity($entity): void
    {
        // Example: save to session
        $_SESSION['wizard_{{wizardName}}'] = $entity;
    }
}
