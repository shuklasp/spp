<div style="text-align: center; margin-bottom: 2rem;">
 <div style="font-size: 0.9rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px;">Current State</div>
 <div style="font-size: 2rem; font-weight: 700; color: var(--text-main); margin: 0.5rem 0;"><?php echo \htmlentities($currentState ?? 'draft'??'', ENT_QUOTES, 'UTF-8', false); ?></div>
</div>

<div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
 <?php $__currentLoopData = $availableTransitions ?? ['submit', 'cancel']; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $transition): $loop = $this->incrementLoopIndices();  ?>
 <button class="btn btn-primary" 
 hx-post="<?= \SPP\App::url('backend-showcase/workflow/transition', 'samvaad') ?>" 
 hx-vals='{"transition": "<?php echo \htmlentities($transition??'', ENT_QUOTES, 'UTF-8', false); ?>"}'
 hx-target="#showcase-container">
 Apply: <?php echo \htmlentities(ucfirst($transition)??'', ENT_QUOTES, 'UTF-8', false); ?>

 </button>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 
 <button class="btn btn-outline" 
 hx-post="<?= \SPP\App::url('backend-showcase/workflow/reset', 'samvaad') ?>" 
 hx-target="#showcase-container" style="margin-top: 1rem; width: 100%;">
 Reset Workflow
 </button>
</div>
