<?php $__currentLoopData = $compounds; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $compound): $loop = $this->incrementLoopIndices();  ?>
 <a href="<?php echo rtrim(\SPP\App::getBaseUrl($app_name ?? \SPP\Scheduler::getContext()), '/') . '/' . ltrim('compound/' . $compound['id'], '/'); ?>" class="compound-card">
 <div class="compound-image-container">
 <img src="<?php echo rtrim(\SPP\App::getBaseUrl($app_name ?? \SPP\Scheduler::getContext()), '/') . '/' . ltrim('assets/compounds/' . $compound['id'] . '.png', '/'); ?>" alt="<?php echo \htmlentities($compound['name']??'', ENT_QUOTES, 'UTF-8', false); ?>" class="compound-image" onerror="this.src='data:image/svg+xml;utf8,<svg xmlns=\'http://www.w3.org/2000/svg\' width=\'100\' height=\'100\' viewBox=\'0 0 24 24\' fill=\'none\' stroke=\'%23cbd5e1\' stroke-width=\'2\'><circle cx=\'12\' cy=\'12\' r=\'10\'></circle><line x1=\'12\' y1=\'8\' x2=\'12\' y2=\'12\'></line><line x1=\'12\' y1=\'16\' x2=\'12.01\' y2=\'16\'></line></svg>';" />
 </div>
 
 <div class="compound-details">
 <div class="compound-header">
 <h3 class="compound-name"><?php echo \htmlentities($compound['name']??'', ENT_QUOTES, 'UTF-8', false); ?></h3>
 <div class="compound-formula"><?php echo $compound['html_formula']; ?></div>
 </div>
 
 <div class="compound-tags">
 <?php if($compound['organic']): ?>
 <span class="tag organic">Organic</span>
 <?php else: ?>
 <span class="tag inorganic">Inorganic</span>
 <?php endif; ?>
 <span class="tag"><?php echo \htmlentities($compound['state']??'', ENT_QUOTES, 'UTF-8', false); ?></span>
 </div>
 
 <p class="compound-desc"><?php echo \htmlentities($compound['description']??'', ENT_QUOTES, 'UTF-8', false); ?></p>
 </div>
 </a>
<?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>

<?php if($hasMore): ?>
 <div id="load-more-container" style="grid-column: 1 / -1; display: flex; justify-content: center; margin-top: 2rem;">
 <button type="button" class="btn btn-primary" 
 hx-get="<?php echo rtrim(\SPP\App::getBaseUrl($app_name ?? \SPP\Scheduler::getContext()), '/') . '/' . ltrim('compounds', '/'); ?>" 
 hx-include="#filterForm"
 hx-vals='{"page": <?php echo \htmlentities($page + 1??'', ENT_QUOTES, 'UTF-8', false); ?>, "append": "1"}'
 hx-target="#load-more-container"
 hx-swap="outerHTML">
 Load More Compounds...
 </button>
 </div>
<?php endif; ?>
