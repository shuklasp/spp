 <header class="ptable-header" style="text-align: center; margin-bottom: 2rem;">
 <h1 style="font-size: 3rem; font-weight: 800; margin-bottom: 0.5rem;"><?php echo \htmlentities($title??'', ENT_QUOTES, 'UTF-8', false); ?></h1>
