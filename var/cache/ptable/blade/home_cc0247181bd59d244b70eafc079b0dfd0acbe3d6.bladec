 </header>
 
 <div style="display: flex; justify-content: center;">
 <!-- Removed overflow-x: auto to allow tooltips to overflow naturally without getting clipped -->
 <div style="width: 100%; max-width: 1400px; padding: 2rem 0;">
 <div style="min-width: 1000px;">
 <!-- Render the external partial per SPP framework rules -->
 <?php echo \SPPMod\Drishyam\TemplateMacros::spppartial('partials/periodic_table.php', ['elements' => $elements]); ?>
 </div>
 </div>
 </div>
</div>

<!-- Modal Overlay -->
<div id="element-modal-overlay" class="modal-overlay" onclick="closeModal(event)">
 <div class="modal-wrapper" onclick="event.stopPropagation()">
 <button class="modal-close" onclick="closeModal()">&times;</button>
 <div id="element-modal-content">
 <!-- HTMX injects the element details here -->
 </div>
 </div>
</div>

<?php $this->stopSection(); ?>

<?php $this->startSection('scripts'); ?>
<script>
 function closeModal(e) {
 if (e && e.target !== document.getElementById('element-modal-overlay') && !e.target.classList.contains('modal-close')) {
 return;
 }
 document.getElementById('element-modal-overlay').classList.remove('active');
 document.body.style.overflow = 'auto';
 
 // Clean up any orphaned tooltips injected by SPP-UX or other libraries
 // This prevents white empty tooltips from getting stuck on the screen when modal elements are removed.
 document.querySelectorAll('.spp-tooltip, .tooltip, [role="tooltip"], .tippy-box, .spp-popover').forEach(el => {
 el.remove();
 });
 
 // Clear modal content after fade out to reset state and re-enable tooltips
 setTimeout(() => {
 const content = document.getElementById('element-modal-content');
 if(content) content.innerHTML = '';
 document.body.classList.remove('modal-open');
 }, 200);
 }

 document.body.addEventListener('htmx:afterSwap', function(evt) {
 if (evt.detail.target.id === 'element-modal-content') {
 document.body.classList.add('modal-open');
 document.getElementById('element-modal-overlay').classList.add('active');
 document.body.style.overflow = 'hidden';
 }
 });

 document.addEventListener('keydown', function(e) {
 if (e.key === 'Escape') {
 closeModal({target: document.getElementById('element-modal-overlay')});
 }
 });
</script>
<?php $this->stopSection(); ?>
<?php if (isset($_shouldextend[1])) { echo $this->runChild('layouts.app'); } ?>