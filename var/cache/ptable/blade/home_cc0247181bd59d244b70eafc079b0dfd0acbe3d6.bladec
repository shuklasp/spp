<?php $this->startSection('styles'); ?>
<style>
 /* Expand the main layout container for this page only */
 .main .layout-container {
 max-width: 1600px !important;
 padding: 0 1rem !important;
 }
 
 /* Legend Styling */
 .legend-item {
 display: flex;
 align-items: center;
 gap: 0.5rem;
 font-size: 0.85rem;
 color: var(--text-muted);
 font-weight: 500;
 }
 .legend-color {
 width: 16px;
 height: 16px;
 border-radius: 4px;
 display: inline-block;
 border: 1px solid rgba(0,0,0,0.1);
 box-shadow: inset 0 0 2px rgba(255,255,255,0.5);
 }
 .legend-color.alkali-metal { background-color: var(--alkali-metal); }
 .legend-color.alkaline-earth-metal { background-color: var(--alkaline-earth-metal); }
 .legend-color.transition-metal { background-color: var(--transition-metal); }
 .legend-color.post-transition-metal { background-color: var(--post-transition-metal); }
 .legend-color.metalloid { background-color: var(--metalloid); }
 .legend-color.nonmetal { background-color: var(--nonmetal); }
 .legend-color.halogen { background-color: var(--halogen); }
 .legend-color.noble-gas { background-color: var(--noble-gas); }
 .legend-color.lanthanide { background-color: var(--lanthanide); }
 .legend-color.actinide { background-color: var(--actinide); }
 
 /* Hover Tooltip Styling */
 .element-box {
 overflow: visible !important;
 position: relative;
 }
 .element-content {
 width: 100%;
 height: 100%;
 display: flex;
 flex-direction: column;
 justify-content: space-between;
 overflow: hidden;
 }
 .element-tooltip {
 position: absolute;
 bottom: 115%;
 left: 50%;
 transform: translateX(-50%);
 background: rgba(15, 23, 42, 0.95);
 color: #fff;
 padding: 0.75rem 1rem;
 border-radius: 8px;
 font-size: 0.85rem;
 white-space: nowrap;
 display: none;
 pointer-events: none;
 z-index: 100;
 box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.3), 0 4px 6px -2px rgba(0, 0, 0, 0.15);
 border: 1px solid rgba(255,255,255,0.1);
 }
 .element-box:hover .element-tooltip {
 display: block;
 }
 
 /* Prevent tooltips from appearing when modal is active */
 body.modal-open .element-tooltip {
 display: none !important;
 }
 .element-tooltip::after {
 content: '';
 position: absolute;
 top: 100%;
 left: 50%;
 margin-left: -6px;
 border-width: 6px;
 border-style: solid;
 border-color: rgba(15, 23, 42, 0.95) transparent transparent transparent;
 }
 
 /* Edge Cases for Tooltips to prevent clipping */
 .element-box[style*="--group: 1;"] .element-tooltip,
 .element-box[style*="--group: 2;"] .element-tooltip {
 left: 0;
 transform: none;
 }
 .element-box[style*="--group: 1;"]:hover .element-tooltip,
 .element-box[style*="--group: 2;"]:hover .element-tooltip {
 transform: none;
 }
 .element-box[style*="--group: 1;"] .element-tooltip::after,
 .element-box[style*="--group: 2;"] .element-tooltip::after {
 left: 15%;
 margin-left: 0;
 }
 
 .element-box[style*="--group: 17;"] .element-tooltip,
 .element-box[style*="--group: 18;"] .element-tooltip {
 left: auto;
 right: 0;
 transform: none;
 }
 .element-box[style*="--group: 17;"]:hover .element-tooltip,
 .element-box[style*="--group: 18;"]:hover .element-tooltip {
 transform: none;
 }
 .element-box[style*="--group: 17;"] .element-tooltip::after,
 .element-box[style*="--group: 18;"] .element-tooltip::after {
 left: auto;
 right: 15%;
 margin-left: 0;
 }
 
 /* Modal Styling */
 .modal-overlay {
 position: fixed;
 top: 0;
 left: 0;
 width: 100vw;
 height: 100vh;
 background: rgba(15, 23, 42, 0.85); /* Slightly darker to compensate for no blur */
 z-index: 9999;
 display: flex;
 justify-content: center;
 align-items: center;
 opacity: 0;
 pointer-events: none;
 transition: opacity 0.1s ease-out;
 }
 .modal-overlay.active {
 opacity: 1;
 pointer-events: auto;
 }
 .modal-wrapper {
 position: relative;
 width: 100%;
 max-width: 900px;
 transform: translateY(15px) scale(0.98);
 opacity: 0;
 transition: all 0.15s cubic-bezier(0, 0, 0.2, 1);
 padding: 1rem;
 }
 .modal-overlay.active .modal-wrapper {
 transform: translateY(0) scale(1);
 opacity: 1;
 }
 .modal-close {
 position: absolute;
 top: 2rem;
 right: 2rem;
 background: rgba(0, 0, 0, 0.05);
 border: none;
 border-radius: 50%;
 width: 40px;
 height: 40px;
 font-size: 1.5rem;
 display: flex;
 align-items: center;
 justify-content: center;
 cursor: pointer;
 z-index: 10;
 color: var(--text-muted);
 transition: all 0.2s ease;
 }
 .modal-close:hover {
 background: rgba(0, 0, 0, 0.1);
 color: var(--text-main);
 transform: rotate(90deg);
 }
 
 /* Ensure the modal content scroll elegantly if too tall */
 #element-modal-content .element-card {
 max-height: 85vh;
 overflow-y: auto;
 box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
 }
</style>
