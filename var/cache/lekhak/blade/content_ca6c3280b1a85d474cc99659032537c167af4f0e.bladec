<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('actions'); ?>
 <a href="<?php echo \htmlentities($admin_root??'', ENT_QUOTES, 'UTF-8', false); ?>/structure/types" class="btn btn-primary" style="padding: 8px 16px; font-size: 0.85rem;">＋ Add Bundle Schema</a>
<?php $this->stopSection(); ?>

<?php $this->startSection('content'); ?>
<!-- Matching Unified Secondary Local Tasks Navigation Header -->
<div class="lekhak-local-tasks-header" style="margin-bottom: 25px; border-bottom: 1px solid var(--glass-border); padding-bottom: 12px; display: flex; gap: 10px; flex-wrap: wrap;">
 <button onclick="filterRepositoryTab('all', this)" class="task-tab-pill active" style="background: var(--accent-primary); color: white; border: none; padding: 6px 16px; border-radius: 20px; font-size: 0.8rem; font-weight: 600; cursor: pointer;">
 Master Stream Registry <span style="font-size: 0.7rem; background: rgba(0,0,0,0.3); padding: 1px 6px; border-radius: 10px;"><?php echo \htmlentities(count($nodes ?? [])??'', ENT_QUOTES, 'UTF-8', false); ?></span>
 </button>
 <button onclick="filterRepositoryTab('published', this)" class="task-tab-pill" style="background: rgba(255,255,255,0.05); color: var(--text-dim); border: 1px solid var(--glass-border); padding: 6px 16px; border-radius: 20px; font-size: 0.8rem; font-weight: 600; cursor: pointer;">
 Active Deployments
 </button>
 <button onclick="filterRepositoryTab('draft', this)" class="task-tab-pill" style="background: rgba(255,255,255,0.05); color: var(--text-dim); border: 1px solid var(--glass-border); padding: 6px 16px; border-radius: 20px; font-size: 0.8rem; font-weight: 600; cursor: pointer;">
 Working Drafts
 </button>
</div>

<div class="glass-panel" style="padding: 25px;">
 <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 10px;">
 <h2 style="font-size: 1.25rem;">Content Repository View</h2>
 <div style="display: flex; gap: 8px;">
 <input type="text" id="repoSearchInput" onkeyup="filterRepoTable()" placeholder="Search documents by string..." style="padding: 8px 14px; border-radius: 6px; border: 1px solid var(--glass-border); background: rgba(0,0,0,0.25); color: white; font-size: 0.85rem; outline: none; min-width: 260px;">
 </div>
 </div>

 <div style="overflow-x: auto;">
 <table id="repoTable" style="width: 100%; text-align: left;">
 <thead>
 <tr>
 <th style="width: 24px;"></th>
 <th>Document Stream Title</th>
 <th>Schema Bundle</th>
 <th>Publish State</th>
 <th>Timestamp Milestone</th>
 <th style="text-align: right;">Grouped inline Commands</th>
 </tr>
 </thead>
 <tbody>
 <?php $__currentLoopData = $nodes ?? []; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $node): $loop = $this->incrementLoopIndices();  ?>
 <tr class="repo-row" data-status="<?php echo \htmlentities($node->status??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <td>
 <div style="width: 8px; height: 8px; border-radius: 50%; background: <?php echo \htmlentities($node->status === 'published' ? 'var(--success)' : 'var(--warning)'??'', ENT_QUOTES, 'UTF-8', false); ?>;"></div>
 </td>
 <td>
 <strong style="font-size: 0.95rem; color: var(--text-main);"><?php echo \htmlentities($node->title??'', ENT_QUOTES, 'UTF-8', false); ?></strong>
 <div style="font-size: 0.7rem; color: var(--text-dim); font-family: monospace;">Entity ID Key: #<?php echo \htmlentities($node->id??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 </td>
 <td><span class="badge badge-warning" style="font-size: 0.7rem;"><?php echo \htmlentities($node->bundle??'', ENT_QUOTES, 'UTF-8', false); ?></span></td>
 <td><span class="badge badge-success" style="font-size: 0.7rem;"><?php echo \htmlentities($node->status??'', ENT_QUOTES, 'UTF-8', false); ?></span></td>
 <td style="color: var(--text-dim); font-size: 0.85rem;"><?php echo \htmlentities(date('M d, Y H:i', strtotime($node->created))??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td style="text-align: right;">
 <div class="repo-inline-actions" style="display: inline-flex; gap: 4px; align-items: center;">
 <a href="<?php echo \htmlentities($admin_root??'', ENT_QUOTES, 'UTF-8', false); ?>/content/edit/<?php echo \htmlentities($node->id??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-secondary" style="padding: 4px 10px; font-size: 0.75rem;">✏️ Edit</a>
 <a href="<?php echo \htmlentities($admin_root??'', ENT_QUOTES, 'UTF-8', false); ?>/content/<?php echo \htmlentities($node->id??'', ENT_QUOTES, 'UTF-8', false); ?>/translate" class="btn btn-secondary" style="padding: 4px 10px; font-size: 0.75rem;">🌐 Translate</a>
 <a href="<?php echo \htmlentities($admin_root??'', ENT_QUOTES, 'UTF-8', false); ?>/content/<?php echo \htmlentities($node->id??'', ENT_QUOTES, 'UTF-8', false); ?>/revisions" class="btn btn-secondary" style="padding: 4px 10px; font-size: 0.75rem;">🕒 Revisions</a>
 <a href="<?php echo \htmlentities($admin_root??'', ENT_QUOTES, 'UTF-8', false); ?>/content/delete/<?php echo \htmlentities($node->id??'', ENT_QUOTES, 'UTF-8', false); ?>" onclick="return confirm('Confirm purging document stream #<?php echo \htmlentities($node->id??'', ENT_QUOTES, 'UTF-8', false); ?>?');" class="btn btn-secondary" style="padding: 4px 10px; font-size: 0.75rem; color: var(--danger);">🗑️ Purge</a>
 </div>
 </td>
 </tr>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 <?php if(empty($nodes)): ?>
 <tr>
 <td colspan="6" style="text-align: center; color: var(--text-dim); padding: 50px;">
 <span style="font-size: 2rem; display: block; margin-bottom: 10px;">📭</span>
 No document streams bound to framework database arrays.
 </td>
 </tr>
 <?php endif; ?>
 </tbody>
 </table>
 </div>
</div>

<script>
 function filterRepositoryTab(mode, button) {
 document.querySelectorAll('.task-tab-pill').forEach(b => {
 b.style.background = 'rgba(255,255,255,0.05)';
 b.style.color = 'var(--text-dim)';
 b.style.border = '1px solid var(--glass-border)';
 });
 button.style.background = 'var(--accent-primary)';
 button.style.color = 'white';
 button.style.border = 'none';

 const rows = document.querySelectorAll('.repo-row');
 rows.forEach(row => {
 if (mode === 'all') {
 row.style.display = '';
 } else if (mode === 'published') {
 row.style.display = row.getAttribute('data-status') === 'published' ? '' : 'none';
 } else {
 row.style.display = row.getAttribute('data-status') !== 'published' ? '' : 'none';
 }
 });
 }

 function filterRepoTable() {
 const input = document.getElementById('repoSearchInput');
 const filter = input.value.toLowerCase();
 const rows = document.querySelectorAll('.repo-row');
 rows.forEach(row => {
 const text = row.textContent.toLowerCase();
 row.style.display = text.includes(filter) ? '' : 'none';
 });
 }
</script>
<?php $this->stopSection(); ?>

<?php if (isset($_shouldextend[1])) { echo $this->runChild('layout'); } ?>