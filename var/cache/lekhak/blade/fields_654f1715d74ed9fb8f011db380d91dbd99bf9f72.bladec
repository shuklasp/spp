<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('actions'); ?>
<a href="<?php echo \htmlentities($admin_root??'', ENT_QUOTES, 'UTF-8', false); ?>/structure/types/<?php echo \htmlentities($bundle??'', ENT_QUOTES, 'UTF-8', false); ?>/fields/add" class="btn btn-primary">
 <span>➕</span> Add Field
</a>
<?php $this->stopSection(); ?>

<?php $this->startSection('content'); ?>
<div class="glass-panel">
 <div style="margin-bottom: 20px;">
 <a href="<?php echo \htmlentities($admin_root??'', ENT_QUOTES, 'UTF-8', false); ?>/structure/types" style="color: var(--accent-primary); text-decoration: none;">← Back to Content Types</a>
 </div>
 
 <table>
 <thead>
 <tr>
 <th>Field Name</th>
 <th>Machine Name</th>
 <th>Type</th>
 <th>Actions</th>
 </tr>
 </thead>
 <tbody>
 <?php $__currentLoopData = $fields ?? []; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $field): $loop = $this->incrementLoopIndices();  ?>
 <tr>
 <td><strong><?php echo \htmlentities($field['label'] ?? $field['name']??'', ENT_QUOTES, 'UTF-8', false); ?></strong></td>
 <td><code><?php echo \htmlentities($field['name']??'', ENT_QUOTES, 'UTF-8', false); ?></code></td>
 <td><?php echo \htmlentities($field['type']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td>
 <a href="#" class="btn btn-secondary" style="padding: 6px 12px; font-size: 0.8rem;">Edit</a>
 </td>
 </tr>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 <?php if(empty($fields)): ?>
 <tr>
 <td colspan="4" style="text-align: center; color: var(--text-dim); padding: 40px;">No fields defined for this bundle.</td>
 </tr>
 <?php endif; ?>
 </tbody>
 </table>
</div>
<?php $this->stopSection(); ?>

<?php if (isset($_shouldextend[1])) { echo $this->runChild('layout'); } ?>