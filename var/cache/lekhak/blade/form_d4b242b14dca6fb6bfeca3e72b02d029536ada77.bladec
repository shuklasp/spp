<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('content'); ?>
<div class="glass-panel" style="max-width: 800px; margin: 0 auto;">
 <div style="margin-bottom: 30px;">
 <h2 style="font-size: 1.5rem; margin-bottom: 10px;"><?php echo \htmlentities($title??'', ENT_QUOTES, 'UTF-8', false); ?></h2>
 <p style="color: var(--text-dim);"><?php echo \htmlentities($subtitle??'', ENT_QUOTES, 'UTF-8', false); ?></p>
 </div>

 <?php echo $form->render(); ?>

 
 <div style="margin-top: 30px; padding-top: 20px; border-top: 1px solid var(--glass-border); display: flex; gap: 15px;">
 <button type="submit" form="<?php echo \htmlentities($form->getAttribute('id')??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-primary">Save Landing Page</button>
 <a href="<?php echo \htmlentities($admin_root??'', ENT_QUOTES, 'UTF-8', false); ?>/landing" class="btn btn-secondary">Cancel</a>
 </div>
</div>
<?php $this->stopSection(); ?>

<?php if (isset($_shouldextend[1])) { echo $this->runChild('layout'); } ?>