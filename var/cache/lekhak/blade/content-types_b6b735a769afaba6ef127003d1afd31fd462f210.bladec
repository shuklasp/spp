<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('actions'); ?>
<a href="<?php echo \htmlentities($admin_root??'', ENT_QUOTES, 'UTF-8', false); ?>/structure/types/add" class="btn btn-primary">
 <span>➕</span> Create New Type
</a>
<?php $this->stopSection(); ?>

<?php $this->startSection('content'); ?>
<div class="glass-panel">
 <table>
 <thead>
 <tr>
 <th>Type Name</th>
 <th>Machine Name</th>
 <th>Strategy</th>
 <th>Actions</th>
 </tr>
 </thead>
 <tbody>
 <?php $__currentLoopData = $types ?? []; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $type): $loop = $this->incrementLoopIndices();  ?>
 <tr>
 <td>
 <div style="font-weight: 600; font-size: 1rem;"><?php echo \htmlentities($type->name??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <div style="font-size: 0.8rem; color: var(--text-dim);"><?php echo \htmlentities($type->description??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 </td>
 <td><code><?php echo \htmlentities($type->machine_name??'', ENT_QUOTES, 'UTF-8', false); ?></code></td>
 <td>
 <span class="badge <?php echo \htmlentities($type->storage_strategy === 'dynamic' ? 'badge-success' : 'badge-warning'??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <?php echo \htmlentities($type->storage_strategy??'', ENT_QUOTES, 'UTF-8', false); ?>

 </span>
 </td>
 <td>
 <div style="display: flex; gap: 10px;">
 <a href="<?php echo \htmlentities($admin_root??'', ENT_QUOTES, 'UTF-8', false); ?>/structure/types/edit/<?php echo \htmlentities($type->machine_name??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-secondary" style="padding: 6px 12px; font-size: 0.8rem;">Edit</a>
 <a href="#" class="btn btn-secondary" style="padding: 6px 12px; font-size: 0.8rem; color: var(--danger);">Delete</a>
 </div>
 </td>
 </tr>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 <?php if(empty($types)): ?>
 <tr>
 <td colspan="4" style="text-align: center; color: var(--text-dim); padding: 40px;">No content types defined yet.</td>
 </tr>
 <?php endif; ?>
 </tbody>
 </table>
</div>
<?php $this->stopSection(); ?>

<?php if (isset($_shouldextend[1])) { echo $this->runChild('layout'); } ?>