 <div style="margin-bottom: 20px;">
 <a href="<?php echo \htmlentities($admin_root??'', ENT_QUOTES, 'UTF-8', false); ?>/structure/types/<?php echo \htmlentities($bundle??'', ENT_QUOTES, 'UTF-8', false); ?>/fields" style="color: var(--accent-primary); text-decoration: none;">← Back to Fields</a>
 </div>

