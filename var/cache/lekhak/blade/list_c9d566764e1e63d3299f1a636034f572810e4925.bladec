<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('actions'); ?>
<a href="<?php echo \htmlentities($admin_root??'', ENT_QUOTES, 'UTF-8', false); ?>/landing/create" class="btn btn-primary">
 <span>➕</span> Create Page
</a>
<?php $this->stopSection(); ?>

<?php $this->startSection('content'); ?>
<div class="glass-panel">
 <table>
 <thead>
 <tr>
 <th>Page Title</th>
 <th>Path Alias</th>
 <th>Status</th>
 <th>Actions</th>
 </tr>
 </thead>
 <tbody>
 <?php $__currentLoopData = $pages ?? []; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $page): $loop = $this->incrementLoopIndices();  ?>
 <tr>
 <td>
 <div style="font-weight: 600; font-size: 1.1rem;">
 <?php echo \htmlentities($page->title??'', ENT_QUOTES, 'UTF-8', false); ?>

 <?php if($page->is_default): ?>
 <span class="badge badge-success" style="font-size: 0.6rem; margin-left: 10px;">HOME</span>
 <?php endif; ?>
 </div>
 </td>
 <td><code>/<?php echo \htmlentities($page->alias??'', ENT_QUOTES, 'UTF-8', false); ?></code></td>
 <td><span class="badge badge-success"><?php echo \htmlentities($page->status??'', ENT_QUOTES, 'UTF-8', false); ?></span></td>
 <td>
 <div style="display: flex; gap: 10px;">
 <a href="<?php echo \htmlentities($admin_root??'', ENT_QUOTES, 'UTF-8', false); ?>/landing/design/<?php echo \htmlentities($page->id??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-secondary" style="padding: 6px 12px; font-size: 0.8rem;">Design</a>
 <?php if(!$page->is_default): ?>
 <a href="<?php echo \htmlentities($admin_root??'', ENT_QUOTES, 'UTF-8', false); ?>/landing/set-default/<?php echo \htmlentities($page->id??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-secondary" style="padding: 6px 12px; font-size: 0.8rem;">Make Home</a>
 <?php endif; ?>
 </div>
 </td>
 </tr>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 <?php if(empty($pages)): ?>
 <tr>
 <td colspan="4" style="text-align: center; color: var(--text-dim); padding: 40px;">No landing pages created yet.</td>
 </tr>
 <?php endif; ?>
 </tbody>
 </table>
</div>
<?php $this->stopSection(); ?>

<?php if (isset($_shouldextend[1])) { echo $this->runChild('layout'); } ?>