<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('actions'); ?>
<a href="/school1/lekhak/admin/content" class="btn btn-secondary">
 ⬅️ Back to Content
</a>
<?php $this->stopSection(); ?>

<?php $this->startSection('content'); ?>
<div class="lekhak-local-tasks-header" style="margin-bottom: 25px; border-bottom: 1px solid var(--glass-border); padding-bottom: 12px;">
 <h2 style="margin: 0; font-size: 1.5rem; color: var(--text-main);"><?php echo \htmlentities($title??'', ENT_QUOTES, 'UTF-8', false); ?></h2>
 <p style="margin: 5px 0 0 0; font-size: 0.9rem; color: var(--text-dim);"><?php echo \htmlentities($subtitle??'', ENT_QUOTES, 'UTF-8', false); ?></p>
</div>

<div style="display: flex; gap: 15px; margin-bottom: 25px;">
 <?php $__currentLoopData = $languages; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $code => $name): $loop = $this->incrementLoopIndices();  ?>
 <a href="?lang=<?php echo \htmlentities($code??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn <?php echo \htmlentities($targetLang === $code ? 'btn-primary' : 'btn-secondary'??'', ENT_QUOTES, 'UTF-8', false); ?>" style="padding: 8px 16px; text-decoration: none;">
 <?php echo \htmlentities($name??'', ENT_QUOTES, 'UTF-8', false); ?>

 </a>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
</div>

<div class="glass-panel" style="padding: 20px;">
 <h3 style="margin-top: 0; color: var(--text-main);">Translating into <?php echo \htmlentities($languages[$targetLang]??'', ENT_QUOTES, 'UTF-8', false); ?></h3>
 
 <?php 
 $fieldsToTranslate = ['title' => $node->title, 'body' => $node->body];
 // Merge custom metadata fields
 if (!empty($node->metadata)) {
 $meta = is_string($node->metadata) ? json_decode($node->metadata, true) : (array)$node->metadata;
 foreach ($meta as $k => $v) {
 if (is_string($v)) {
 $fieldsToTranslate[$k] = $v;
 }
 }
 }
 ?>

 <table style="width: 100%; border-collapse: collapse; text-align: left;">
 <thead>
 <tr style="border-bottom: 1px solid var(--glass-border);">
 <th style="padding: 12px; color: var(--text-dim); font-size: 0.85rem; width: 15%;">Field</th>
 <th style="padding: 12px; color: var(--text-dim); font-size: 0.85rem; width: 35%;">Original (English)</th>
 <th style="padding: 12px; color: var(--text-dim); font-size: 0.85rem; width: 50%;">Translation</th>
 </tr>
 </thead>
 <tbody>
 <?php $__currentLoopData = $fieldsToTranslate; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $field => $originalValue): $loop = $this->incrementLoopIndices();  ?>
 <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
 <td style="padding: 16px 12px; vertical-align: top; font-weight: bold; color: var(--accent-primary);">
 <?php echo \htmlentities(ucfirst($field)??'', ENT_QUOTES, 'UTF-8', false); ?>

 </td>
 <td style="padding: 16px 12px; vertical-align: top; color: var(--text-dim); background: rgba(0,0,0,0.1); border-right: 1px solid var(--glass-border);">
 <?php echo \htmlentities($originalValue??'', ENT_QUOTES, 'UTF-8', false); ?>

 </td>
 <td style="padding: 16px 12px; vertical-align: top;">
 <form id="form-<?php echo \htmlentities($field??'', ENT_QUOTES, 'UTF-8', false); ?>" method="POST" action="" style="display: flex; gap: 10px; flex-direction: column;">
 <input type="hidden" name="action" value="save_translation">
 <input type="hidden" name="field" value="<?php echo \htmlentities($field??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <?php if($field === 'body' || $field === 'description'): ?>
 <div id="lekhni-host-<?php echo \htmlentities($field??'', ENT_QUOTES, 'UTF-8', false); ?>" style="height: 500px; width: 100%; border: 1px solid var(--glass-border); border-radius: 8px; overflow: hidden; position: relative;"></div>
 <textarea id="textarea-<?php echo \htmlentities($field??'', ENT_QUOTES, 'UTF-8', false); ?>" name="value" style="display:none;"><?php echo \htmlentities($translations[$field] ?? ''??'', ENT_QUOTES, 'UTF-8', false); ?></textarea>
 <script type="module">
 import LekhniEditor from '<?php echo \htmlentities(rtrim($web_root ?? '', '/')??'', ENT_QUOTES, 'UTF-8', false); ?>/src/lekhak/comp/editor.js?v=1';
 const host = document.getElementById('lekhni-host-<?php echo \htmlentities($field??'', ENT_QUOTES, 'UTF-8', false); ?>');
 const txt = document.getElementById('textarea-<?php echo \htmlentities($field??'', ENT_QUOTES, 'UTF-8', false); ?>');
 const dummyAdapter = { notify: (msg, type) => console.log(msg) };
 const editor = new LekhniEditor(dummyAdapter, host, {
 body: txt.value,
 embedded: true,
 onChange: (val) => { txt.value = val; }
 });
 window.lekhniEditor_<?php echo \htmlentities($field??'', ENT_QUOTES, 'UTF-8', false); ?> = editor;
 editor.onInit().then(() => {
 editor.update();
 if (editor.onMount) editor.onMount();
 });
 document.getElementById('form-<?php echo \htmlentities($field??'', ENT_QUOTES, 'UTF-8', false); ?>').addEventListener('submit', () => {
 if (editor.state && typeof editor.state.body !== 'undefined') {
 txt.value = editor.state.body;
 }
 });
 </script>
 <?php else: ?>
 <textarea name="value" rows="4" class="form-control" style="width: 100%; padding: 10px; background: rgba(255,255,255,0.03); border: 1px solid var(--glass-border); color: var(--text-main); border-radius: 4px; resize: vertical;"><?php echo \htmlentities($translations[$field] ?? ''??'', ENT_QUOTES, 'UTF-8', false); ?></textarea>
 <?php endif; ?>
 <div style="text-align: right;">
 <button type="submit" class="btn btn-primary" style="padding: 6px 12px; font-size: 0.85rem;">Save <?php echo \htmlentities(ucfirst($field)??'', ENT_QUOTES, 'UTF-8', false); ?></button>
 </div>
 </form>
 </td>
 </tr>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </tbody>
 </table>
</div>
<?php $this->stopSection(); ?>

<?php if (isset($_shouldextend[1])) { echo $this->runChild('layout'); } ?>