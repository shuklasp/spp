 background: rgba(255,255,255,0.02);
 border: 1px solid var(--glass-border);
 padding: 8px;
 border-radius: 4px;
 display: flex;
 align-items: center;
 gap: 8px;
}
.btn-sort {
 background: transparent; border: none; color: var(--text-dim); cursor: pointer; font-size: 1rem;
 padding: 0 4px;
}
.btn-sort:hover { color: var(--text-main); }
</style>

<script>
const viewsData = <?php echo json_encode(array_values($views ?? []), 15, 512); ?>;
const entityFieldsMap = <?php echo json_encode($entityFieldsMap, 15, 512); ?>;

let currentEditingId = null;
let displayCount = 0;

function getCurrentSchemaFields() {
 const cls = document.getElementById('viewEntityClass').value;
 return entityFieldsMap[cls] || {};
}

function updateSchemaDependentFields() {
 // Re-render display fields
 const dispContainer = document.getElementById('displayFieldsContainer');
 const existingDispVals = Array.from(dispContainer.querySelectorAll('.disp-field-select')).map(sel => sel.value);
 dispContainer.innerHTML = '';
 if (existingDispVals.length > 0) {
 existingDispVals.forEach(val => addDisplayFieldRow(val));
 } else {
 addDisplayFieldRow('id');
 addDisplayFieldRow('title');
 addDisplayFieldRow('status');
 }

 // Re-render condition fields
 const condContainer = document.getElementById('conditionsContainer');
 const existingConds = Array.from(condContainer.querySelectorAll('.condition-row')).map(row => {
 return {
 field: row.querySelector('.cond-field-select').value,
 operator: row.querySelector('.cond-operator').value,
 value: row.querySelector('.cond-value').value
 };
 });
 condContainer.innerHTML = '';
 existingConds.forEach(cond => addConditionRow(cond.field, cond.operator, cond.value));

 // Re-render sort field
 const sortFieldSelect = document.getElementById('viewSortField');
 const currentSort = sortFieldSelect.value;
 sortFieldSelect.innerHTML = '';
 const fields = getCurrentSchemaFields();
 
 // Default option
 sortFieldSelect.appendChild(new Option('-- None --', ''));
 
 for (const [key, config] of Object.entries(fields)) {
 const opt = new Option(`${config.label} (${key})`, key);
 if (key === currentSort) opt.selected = true;
 sortFieldSelect.appendChild(opt);
 }
}

function renderViewsList() {
 const container = document.getElementById('viewsListContainer');
 container.innerHTML = '';
 
 if (viewsData.length === 0) {
 container.innerHTML = '<div style="color: var(--text-dim); text-align: center; padding: 20px; font-size: 0.9rem;">No custom views built yet.</div>';
 return;
 }
 
 viewsData.forEach(view => {
 const activeClass = currentEditingId === view.id ? 'active' : '';
 const card = document.createElement('div');
 card.className = `view-item-card ${activeClass}`;
 card.onclick = () => editView(view.id);
 
 let displaysBadge = (view.displays || []).length;
 
 card.innerHTML = `
 <div style="flex-grow: 1;">
 <div style="font-weight: 600; color: var(--text-main); font-size: 0.95rem;">${view.name}</div>
 <div style="font-size: 0.75rem; color: var(--text-dim); font-family: monospace; margin-top: 2px;">ID: ${view.id} | ${displaysBadge} Displays</div>
 </div>
 <span style="font-size: 1.2rem;">👁️</span>
 `;
 container.appendChild(card);
 });
}

function createNewView() {
 currentEditingId = null;
 document.getElementById('formPanelTitle').textContent = 'Create Query View';
 
 document.getElementById('viewId').value = '';
 document.getElementById('viewId').disabled = false;
 document.getElementById('viewName').value = '';
 
 const entityClassSelect = document.getElementById('viewEntityClass');
 if (entityClassSelect.options.length > 0) {
 let found = false;
 for(let i=0; i<entityClassSelect.options.length; i++) {
 if (entityClassSelect.options[i].value === '\\SPPMod\\Lekhak\\Core\\LekhakNode') {
 entityClassSelect.selectedIndex = i;
 found = true; break;
 }
 }
 if (!found) entityClassSelect.selectedIndex = 0;
 }
 
 document.getElementById('displayFieldsContainer').innerHTML = '';
 document.getElementById('conditionsContainer').innerHTML = '';
 document.getElementById('displaysContainer').innerHTML = '';
 
 updateSchemaDependentFields();
 
 addDisplay('page');
 renderViewsList();
}

function editView(id) {
 const view = viewsData.find(v => v.id === id);
 if (!view) return;
 
 currentEditingId = id;
 document.getElementById('formPanelTitle').textContent = 'Edit Query View: ' + view.name;
 
 document.getElementById('viewId').value = view.id;
 document.getElementById('viewId').disabled = true;
 document.getElementById('viewName').value = view.name;
 
 if (view.entity_class) {
 let cls = view.entity_class.replace(/\\\\/g, '\\');
 document.getElementById('viewEntityClass').value = cls;
 }
 
 document.getElementById('displayFieldsContainer').innerHTML = '';
 document.getElementById('conditionsContainer').innerHTML = '';
 document.getElementById('displaysContainer').innerHTML = '';
 
 const displayFields = view.display_fields || [];
 displayFields.forEach(f => {
 addDisplayFieldRow(f);
 });
 
 updateSchemaDependentFields(); // Sets up sort field options and updates existing fields
 
 if (view.sort) {
 document.getElementById('viewSortField').value = view.sort.field || '';
 document.getElementById('viewSortDirection').value = view.sort.direction || 'DESC';
 } else {
 document.getElementById('viewSortField').value = '';
 document.getElementById('viewSortDirection').value = 'DESC';
 }
 
 if (view.conditions && view.conditions.length > 0) {
 view.conditions.forEach(cond => {
 addConditionRow(cond.field, cond.operator, cond.value);
 });
 }
 
 if (view.displays && view.displays.length > 0) {
 view.displays.forEach(disp => {
 addDisplay(disp.type, disp);
 });
 } else {
 if (view.limit || view.template) {
 addDisplay('page', { limit: view.limit, template: view.template, path: '/view/' + view.id, name: 'Legacy Page' });
 }
 }
 
 renderViewsList();
}

function generateFieldOptionsHtml(selectedValue) {
 const fields = getCurrentSchemaFields();
 let html = '';
 for (const [key, config] of Object.entries(fields)) {
 const selected = (key === selectedValue) ? 'selected' : '';
 html += `<option value="${key}" ${selected}>${config.label} (${key})</option>`;
 }
 // Also allow arbitrary fields (like dynamic ones)
 if (selectedValue && !fields[selectedValue]) {
 html += `<option value="${selectedValue}" selected>${selectedValue} (Custom)</option>`;
 }
 return html;
}

function addDisplayFieldRow(val = '') {
 const container = document.getElementById('displayFieldsContainer');
 const rowId = 'df-row-' + Date.now() + Math.random().toString(36).substr(2, 5);
 
 const row = document.createElement('div');
 row.id = rowId;
 row.className = 'display-field-row';
 
 row.innerHTML = `
 <div style="display: flex; flex-direction: column;">
 <button type="button" class="btn-sort" onclick="moveDisplayFieldUp('${rowId}')">⬆️</button>
 <button type="button" class="btn-sort" onclick="moveDisplayFieldDown('${rowId}')">⬇️</button>
 </div>
 <select class="form-control disp-field-select" style="flex-grow: 1; padding: 8px 12px; background: var(--sidebar-bg); border: 1px solid var(--glass-border); color: var(--text); border-radius: 4px; font-size: 0.85rem;">
 ${generateFieldOptionsHtml(val)}
 </select>
 <button type="button" onclick="document.getElementById('${rowId}').remove()" class="btn btn-secondary" style="padding: 8px; color: var(--danger); font-size: 0.85rem; border: none; background: transparent; cursor: pointer;">✕</button>
 `;
 
 container.appendChild(row);
}

function moveDisplayFieldUp(rowId) {
 const row = document.getElementById(rowId);
 if (row.previousElementSibling) {
 row.parentNode.insertBefore(row, row.previousElementSibling);
 }
}

function moveDisplayFieldDown(rowId) {
 const row = document.getElementById(rowId);
 if (row.nextElementSibling) {
 row.parentNode.insertBefore(row.nextElementSibling, row);
 }
}

function addConditionRow(field = '', operator = '=', value = '') {
 const container = document.getElementById('conditionsContainer');
 const rowId = 'cond-row-' + Date.now() + Math.random().toString(36).substr(2, 5);
 
 const row = document.createElement('div');
 row.id = rowId;
 row.className = 'condition-row';
 row.style.background = 'rgba(255,255,255,0.02)';
 row.style.border = '1px solid var(--glass-border)';
 row.style.padding = '12px';
 row.style.borderRadius = '6px';
 
 row.innerHTML = `
 <div style="display: grid; grid-template-columns: 2fr 1fr 2fr auto; gap: 8px; align-items: start;">
 <select class="form-control cond-field-select" style="padding: 8px 12px; background: var(--sidebar-bg); border: 1px solid var(--glass-border); color: var(--text); border-radius: 4px; font-size: 0.85rem;" onchange="updateConditionValueInput('${rowId}')">
 ${generateFieldOptionsHtml(field)}
 </select>
 <select class="form-control cond-operator" style="padding: 8px 12px; background: var(--sidebar-bg); border: 1px solid var(--glass-border); color: var(--text); border-radius: 4px; font-size: 0.85rem;">
 <option value="=" ${operator === '=' ? 'selected' : ''}>=</option>
 <option value="!=" ${operator === '!=' ? 'selected' : ''}>!=</option>
 <option value="LIKE" ${operator === 'LIKE' ? 'selected' : ''}>LIKE</option>
 <option value=">" ${operator === '>' ? 'selected' : ''}>&gt;</option>
 <option value="<" ${operator === '<' ? 'selected' : ''}>&lt;</option>
 <option value="IN" ${operator === 'IN' ? 'selected' : ''}>IN</option>
 </select>
 <div class="cond-value-container" style="display: flex; flex-direction: column; gap: 4px;">
 <!-- Replaced dynamically based on field type -->
 <input type="text" value="${value.replace(/"/g, '&quot;')}" class="form-control cond-value" style="padding: 8px 12px; background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); color: white; border-radius: 4px; font-size: 0.85rem;">
 </div>
 <button type="button" onclick="document.getElementById('${rowId}').remove()" class="btn btn-secondary" style="padding: 8px; color: var(--danger); font-size: 0.85rem; border: none; background: transparent; cursor: pointer;">✕</button>
 </div>
 `;
 
 container.appendChild(row);
 updateConditionValueInput(rowId, value); // Initialize correct input type
}

function updateConditionValueInput(rowId, initialValue = '') {
 const row = document.getElementById(rowId);
 if (!row) return;
 
 const fieldSelect = row.querySelector('.cond-field-select');
 const valueContainer = row.querySelector('.cond-value-container');
 const fieldKey = fieldSelect.value;
 
 const fields = getCurrentSchemaFields();
 const config = fields[fieldKey] || { type: 'text' };
 
 let html = '';
 if (config.type === 'select' && config.options) {
 html = `<select class="form-control cond-value" style="padding: 8px 12px; background: var(--sidebar-bg); border: 1px solid var(--glass-border); color: var(--text); border-radius: 4px; font-size: 0.85rem;">`;
 for (const [val, label] of Object.entries(config.options)) {
 const selected = (val === initialValue) ? 'selected' : '';
 html += `<option value="${val}" ${selected}>${label}</option>`;
 }
 html += `</select>`;
 } else {
 html = `<input type="text" placeholder="Value" value="${initialValue.replace(/"/g, '&quot;')}" class="form-control cond-value" style="padding: 8px 12px; background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); color: white; border-radius: 4px; font-size: 0.85rem;">`;
 if (config.tip) {
 html += `<div style="font-size: 0.75rem; color: var(--text-dim); margin-top: 2px;">💡 ${config.tip}</div>`;
 }
 }
 
 valueContainer.innerHTML = html;
}

function addDisplay(type, data = {}) {
 displayCount++;
 const container = document.getElementById('displaysContainer');
 const dispId = 'display-card-' + Date.now() + displayCount;
 
 const card = document.createElement('div');
 card.id = dispId;
 card.className = 'display-card';
 card.setAttribute('data-type', type);
 
 const name = data.name || (type === 'page' ? 'Page Display' : 'Block Display');
 const limit = data.limit || 10;
 const template = data.template || '';
 const path = data.path || '';
 const pagination = data.pagination || 'none';
 
 let specificFields = '';
 if (type === 'page') {
 specificFields = `
 <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px;">
 <div class="form-group" style="margin-bottom: 0;">
 <label style="display: block; margin-bottom: 4px; font-size: 0.8rem; color: var(--text-main);">Page Path</label>
 <input type="text" class="form-control disp-path" placeholder="/news" value="${path}" required style="width: 100%; padding: 8px 12px; background: rgba(255,255,255,0.03); border: 1px solid var(--glass-border); color: var(--text-main); border-radius: 4px; font-size: 0.85rem;">
 </div>
 <div class="form-group" style="margin-bottom: 0;">
 <label style="display: block; margin-bottom: 4px; font-size: 0.8rem; color: var(--text-main);">Pagination</label>
 <select class="form-control disp-pagination" style="width: 100%; padding: 8px 12px; background: var(--sidebar-bg); border: 1px solid var(--glass-border); color: var(--text-main); border-radius: 4px; font-size: 0.85rem;">
 <option value="none" ${pagination === 'none' ? 'selected' : ''}>None</option>
 <option value="traditional" ${pagination === 'traditional' ? 'selected' : ''}>Traditional (Next/Prev)</option>
 <option value="infinite" ${pagination === 'infinite' ? 'selected' : ''}>Infinite Scroll</option>
 </select>
 </div>
 </div>
 `;
 }

 card.innerHTML = `
 <button type="button" onclick="document.getElementById('${dispId}').remove()" style="position: absolute; top: 12px; right: 12px; background: transparent; border: none; color: #ef4444; cursor: pointer;">✕ Remove</button>
 <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 12px;">
 <span style="font-size: 1.2rem;">${type === 'page' ? '📄' : '🧱'}</span>
 <input type="text" class="form-control disp-name" value="${name}" required style="background: transparent; border: none; border-bottom: 1px dashed var(--glass-border); color: var(--text-main); font-size: 1rem; font-weight: 600; outline: none; padding: 4px 0; width: 250px;">
 </div>
 ${specificFields}
 <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 12px;">
 <div class="form-group" style="margin-bottom: 0;">
 <label style="display: block; margin-bottom: 4px; font-size: 0.8rem; color: var(--text-main);">Items Limit</label>
 <input type="number" class="form-control disp-limit" value="${limit}" min="0" style="width: 100%; padding: 8px 12px; background: rgba(255,255,255,0.03); border: 1px solid var(--glass-border); color: var(--text-main); border-radius: 4px; font-size: 0.85rem;">
 </div>
 <div class="form-group" style="margin-bottom: 0;">
 <label style="display: block; margin-bottom: 4px; font-size: 0.8rem; color: var(--text-main);">Template</label>
 <select class="form-control disp-template-select" onchange="toggleCustomTemplateInput(this)" style="width: 100%; padding: 8px 12px; background: var(--sidebar-bg); border: 1px solid var(--glass-border); color: var(--text-main); border-radius: 4px; font-size: 0.85rem; margin-bottom: 8px;">
 <option value="">-- Default (Auto-generated) --</option>
 <option value="views/list" ${template === 'views/list' ? 'selected' : ''}>List View</option>
 <option value="views/grid" ${template === 'views/grid' ? 'selected' : ''}>Grid View</option>
 <option value="views/table" ${template === 'views/table' ? 'selected' : ''}>Table View</option>
 <option value="custom" ${template && !['views/list', 'views/grid', 'views/table'].includes(template) ? 'selected' : ''}>Custom Template...</option>
 </select>
 <input type="text" class="form-control disp-template-custom" placeholder="path/to/custom-template" value="${template && !['views/list', 'views/grid', 'views/table'].includes(template) ? template : ''}" style="width: 100%; padding: 8px 12px; background: rgba(255,255,255,0.03); border: 1px solid var(--glass-border); color: var(--text-main); border-radius: 4px; font-size: 0.85rem; display: ${template && !['views/list', 'views/grid', 'views/table'].includes(template) ? 'block' : 'none'};">
 </div>
 </div>
 `;
 
 container.appendChild(card);
}

document.getElementById('viewsBuilderForm').addEventListener('submit', async (e) => {
 e.preventDefault();
 
 const displayFields = Array.from(document.querySelectorAll('.disp-field-select')).map(s => s.value).filter(Boolean);
 
 if (displayFields.length === 0) {
 alert("You must define at least one Display Field.");
 return;
 }
 
 const conditionRows = document.querySelectorAll('.condition-row');
 const conditions = [];
 conditionRows.forEach(row => {
 const field = row.querySelector('.cond-field-select').value.trim();
 const operator = row.querySelector('.cond-operator').value;
 const value = row.querySelector('.cond-value').value; // Might be empty, but that's fine for some queries
 if (field) conditions.push({ field, operator, value });
 });
 
 const sortField = document.getElementById('viewSortField').value.trim();
 const sortDirection = document.getElementById('viewSortDirection').value;
 
 const displays = [];
 document.querySelectorAll('.display-card').forEach((card, idx) => {
 const type = card.getAttribute('data-type');
 const templateSelect = card.querySelector('.disp-template-select').value;
 const templateCustom = card.querySelector('.disp-template-custom').value.trim();
 const finalTemplate = templateSelect === 'custom' ? templateCustom : templateSelect;

 const disp = {
 id: type + '_' + idx,
 type: type,
 name: card.querySelector('.disp-name').value.trim(),
 limit: parseInt(card.querySelector('.disp-limit').value) || 10,
 template: finalTemplate || null
 };
 if (type === 'page') {
 disp.path = card.querySelector('.disp-path').value.trim();
 disp.pagination = card.querySelector('.disp-pagination').value;
 }
 displays.push(disp);
 });

 if (displays.length === 0) {
 alert("You must define at least one Display (Page or Block) for this view.");
 return;
 }
 
 const payload = {
 id: document.getElementById('viewId').value.trim(),
 name: document.getElementById('viewName').value.trim(),
 entity_class: document.getElementById('viewEntityClass').value.trim(),
 display_fields: displayFields,
 conditions: conditions,
 sort: sortField ? { field: sortField, direction: sortDirection } : null,
 displays: displays
 };
 
 try {
 const res = await fetch('?action=apiSaveView', {
 method: 'POST',
 headers: {'Content-Type': 'application/json'},
 body: JSON.stringify(payload)
 });
 const data = await res.json();
 if (data.status === 'success') {
 alert('View configuration saved successfully!');
 location.reload();
 } else {
 alert('Error: ' + data.message);
 }
 } catch (err) {
 alert('API Request Failed. Check connection.');
 }
});

function toggleCustomTemplateInput(selectElem) {
 const customInput = selectElem.nextElementSibling;
 if (selectElem.value === 'custom') {
 customInput.style.display = 'block';
 customInput.required = true;
 } else {
 customInput.style.display = 'none';
 customInput.required = false;
 }
}

// Initial Render
renderViewsList();
if (viewsData.length > 0) {
 editView(viewsData[0].id);
} else {
 createNewView();
}

// Make sure initial state has proper field configuration mapped
updateSchemaDependentFields();
</script>
<?php $this->stopSection(); ?>
<?php if (isset($_shouldextend[1])) { echo $this->runChild('layout'); } ?>