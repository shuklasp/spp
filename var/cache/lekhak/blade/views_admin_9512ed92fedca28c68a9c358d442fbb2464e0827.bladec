<?php
$entitySchemas = [];
$corePath = SPP_APP_DIR . '/modules/lekhak/src/Core/';
if (is_dir($corePath)) {
 foreach (glob($corePath . '*.php') as $file) {
 $className = basename($file, '.php');
 $fullClass = '\\SPPMod\\Lekhak\\Core\\' . $className;
 // Fallbacks for known classes in case they aren't loaded yet
 if ($className === 'LekhakNode' || $className === 'LekhakUser') {
 $label = preg_replace('/(?<!^)([A-Z])/', ' $1', $className);
 $entitySchemas[$label] = $fullClass;
 } elseif (class_exists($fullClass) && is_subclass_of($fullClass, '\\SPPMod\\SPPEntity\\SppEntity')) {
 $label = preg_replace('/(?<!^)([A-Z])/', ' $1', $className);
 $entitySchemas[$label] = $fullClass;
 }
 }
}
if (empty($entitySchemas)) {
 $entitySchemas['Lekhak Node'] = '\\SPPMod\\Lekhak\\Core\\LekhakNode';
 $entitySchemas['Lekhak User'] = '\\SPPMod\\Lekhak\\Core\\LekhakUser';
}

$entityFieldsMap = [
 '\\SPPMod\\Lekhak\\Core\\LekhakNode' => [
 'id' => ['type' => 'number', 'label' => 'ID'],
 'title' => ['type' => 'text', 'label' => 'Title', 'tip' => 'Text value for exact match or LIKE search'],
 'status' => ['type' => 'select', 'label' => 'Status', 'options' => ['published' => 'Published', 'draft' => 'Draft', 'archived' => 'Archived']],
 'bundle' => ['type' => 'text', 'label' => 'Content Type (Bundle)', 'tip' => 'Enter machine name of content type (e.g. article)'],
 'author_id' => ['type' => 'number', 'label' => 'Author ID', 'tip' => 'Numeric user ID'],
 'created' => ['type' => 'text', 'label' => 'Created Date', 'tip' => 'Format: YYYY-MM-DD'],
 'changed' => ['type' => 'text', 'label' => 'Last Changed', 'tip' => 'Format: YYYY-MM-DD']
 ],
 '\\SPPMod\\Lekhak\\Core\\LekhakUser' => [
 'id' => ['type' => 'number', 'label' => 'ID'],
 'username' => ['type' => 'text', 'label' => 'Username', 'tip' => 'Exact username'],
 'email' => ['type' => 'text', 'label' => 'Email', 'tip' => 'Exact email address'],
 'status' => ['type' => 'select', 'label' => 'Status', 'options' => ['active' => 'Active', 'inactive' => 'Inactive']],
 'role_id' => ['type' => 'number', 'label' => 'Role ID', 'tip' => 'Numeric role ID'],
 'created_at' => ['type' => 'text', 'label' => 'Created Date', 'tip' => 'Format: YYYY-MM-DD']
 ],
 '\\SPPMod\\Lekhak\\Core\\LekhakComment' => [
 'id' => ['type' => 'number', 'label' => 'ID'],
 'node_id' => ['type' => 'number', 'label' => 'Node ID', 'tip' => 'Numeric ID of the parent node'],
 'author_id' => ['type' => 'number', 'label' => 'Author ID', 'tip' => 'Numeric user ID'],
 'status' => ['type' => 'select', 'label' => 'Status', 'options' => ['published' => 'Published', 'hidden' => 'Hidden']],
 'created' => ['type' => 'text', 'label' => 'Created Date', 'tip' => 'Format: YYYY-MM-DD']
 ],
 '\\SPPMod\\Lekhak\\Core\\LekhakTaxonomyTerm' => [
 'id' => ['type' => 'number', 'label' => 'ID'],
 'vid' => ['type' => 'number', 'label' => 'Vocabulary ID', 'tip' => 'Numeric vocabulary ID'],
 'name' => ['type' => 'text', 'label' => 'Name', 'tip' => 'Term name string'],
 'weight' => ['type' => 'number', 'label' => 'Weight', 'tip' => 'Numeric sort weight'],
 'parent_id' => ['type' => 'number', 'label' => 'Parent ID', 'tip' => 'Numeric parent term ID']
 ],
 '\\SPPMod\\Lekhak\\Core\\LekhakForumTopic' => [
 'id' => ['type' => 'number', 'label' => 'ID'],
 'forum_id' => ['type' => 'number', 'label' => 'Forum ID', 'tip' => 'Numeric ID of the parent forum term'],
 'title' => ['type' => 'text', 'label' => 'Title', 'tip' => 'Topic title'],
 'author_id' => ['type' => 'number', 'label' => 'Author ID', 'tip' => 'Numeric user ID'],
 'status' => ['type' => 'select', 'label' => 'Status', 'options' => ['open' => 'Open', 'closed' => 'Closed', 'hidden' => 'Hidden']],
 'created' => ['type' => 'text', 'label' => 'Created Date', 'tip' => 'Format: YYYY-MM-DD']
 ]
];
?>
<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('actions'); ?>
<button onclick="createNewView()" class="btn btn-primary">
 <span>➕</span> Define New View
</button>
<?php $this->stopSection(); ?>

<?php $this->startSection('content'); ?>
