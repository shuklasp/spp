<!DOCTYPE html>
<html lang="en">
<head>
 <meta charset="UTF-8">
 <meta name="viewport" content="width=device-width, initial-scale=1.0">
 <title><?php echo \htmlentities($page->title??'', ENT_QUOTES, 'UTF-8', false); ?></title>
 <link rel="stylesheet" href="/school1/res/spp/css/spp.css">
 <style>
 :root {
 --primary: #2563eb;
 --primary-dark: #1d4ed8;
 --bg: #0f172a;
 --text: #f1f5f9;
 }
 body {
 margin: 0;
 font-family: 'Inter', system-ui, sans-serif;
 background: var(--bg);
 color: var(--text);
 line-height: 1.5;
 }
 .container {
 max-width: 1200px;
 margin: 0 auto;
 padding: 0 20px;
 }
 section {
 padding: 80px 0;
 }
 
 /* Hero Block */
 .hero {
 background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
 text-align: center;
 min-height: 60vh;
 display: flex;
 align-items: center;
 }
 .hero h1 {
 font-size: 4rem;
 margin-bottom: 20px;
 background: linear-gradient(to right, #60a5fa, #a855f7);
 -webkit-background-clip: text;
 -webkit-text-fill-color: transparent;
 }
 .hero p {
 font-size: 1.25rem;
 color: #94a3b8;
 max-width: 600px;
 margin: 0 auto 30px;
 }
 
 /* Features Block */
 .features-grid {
 display: grid;
 grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
 gap: 30px;
 }
 .feature-card {
 background: #1e293b;
 padding: 30px;
 border-radius: 16px;
 border: 1px solid rgba(255,255,255,0.1);
 }
 
 /* Button Style */
 .btn {
 display: inline-block;
 padding: 12px 24px;
 border-radius: 8px;
 font-weight: 600;
 text-decoration: none;
 transition: all 0.2s;
 }
 .btn-primary {
 background: var(--primary);
 color: white;
 }
 .btn-primary:hover {
 background: var(--primary-dark);
 transform: translateY(-2px);
 }
 </style>
</head>
<body>
 <?php $__currentLoopData = $blocks; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $block): $loop = $this->incrementLoopIndices();  ?>
 <?php $content = $block->getContent();  ?>
 
 <?php if($block->block_type == 'hero'): ?>
 <section class="hero">
 <div class="container">
 <h1><?php echo \htmlentities($content['title'] ?? ''??'', ENT_QUOTES, 'UTF-8', false); ?></h1>
 <p><?php echo \htmlentities($content['subtitle'] ?? ''??'', ENT_QUOTES, 'UTF-8', false); ?></p>
 <a href="#" class="btn btn-primary"><?php echo \htmlentities($content['button_text'] ?? 'Learn More'??'', ENT_QUOTES, 'UTF-8', false); ?></a>
 </div>
 </section>
 <?php elseif($block->block_type == 'text'): ?>
 <section class="text-content">
 <div class="container">
 <?php echo $content['content'] ?? ''; ?>

 </div>
 </section>
 <?php elseif($block->block_type == 'features'): ?>
 <section class="features">
 <div class="container">
 <h2 style="text-align:center; margin-bottom: 50px;"><?php echo \htmlentities($content['title'] ?? 'Our Features'??'', ENT_QUOTES, 'UTF-8', false); ?></h2>
 <div class="features-grid">
 <?php $__currentLoopData = $content['items'] ?? []; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $item): $loop = $this->incrementLoopIndices();  ?>
 <div class="feature-card">
 <div style="font-size: 2rem; margin-bottom: 15px;"><?php echo \htmlentities($item['icon']??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <h3><?php echo \htmlentities($item['text']??'', ENT_QUOTES, 'UTF-8', false); ?></h3>
 </div>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </div>
 </div>
 </section>
 <?php elseif($block->block_type == 'dynamic_list'): ?>
 <section class="dynamic-list">
 <div class="container">
 <h2 style="margin-bottom: 30px;"><?php echo \htmlentities($content['title'] ?? 'Latest Content'??'', ENT_QUOTES, 'UTF-8', false); ?></h2>
 <?php $entities = $block->resolveEntities();  ?>
 <div class="entities-grid">
 <?php $__currentLoopData = $entities; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $entity): $loop = $this->incrementLoopIndices();  ?>
 <div class="entity-card glass-panel" style="margin-bottom: 15px; padding: 20px;">
 <h3><?php echo \htmlentities($entity->title ?? ($entity->username ?? 'Untitled')??'', ENT_QUOTES, 'UTF-8', false); ?></h3>
 <p style="color: #94a3b8; font-size: 0.9rem;">
 Type: <?php echo \htmlentities($entity->bundle ?? 'Generic'??'', ENT_QUOTES, 'UTF-8', false); ?> | 
 Created: <?php echo \htmlentities($entity->created??'', ENT_QUOTES, 'UTF-8', false); ?>

 </p>
 </div>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </div>
 </div>
 </section>
 <?php endif; ?>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
</body>
</html>
