<div class="sliding-sidebar animated-panel-from-right">
  <div class="sliding-sidebar-container block-section">
    <div class="close close-sliding-sidebar">x</div>
      {% if page.sidebar_sliding %}
        {{ page.sidebar_sliding }}
      {% else %}
        <p>Please add some content in <a href="{{ base_path }}admin/structure/block">Animated Sidebar</a> block region.</p><p>For more information please refer to this tutorial page:<br /><a href="https://drupar.com/node/1239" target="_blank">Add content in sliding sidebar</a></p>
      {% endif %}<!-- /page.sidebar_sliding -->
  </div>
</div> <!-- /.sliding-sidebar -->
