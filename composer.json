{
  "name": "shuklasp/spp",
  "description": "Satya Portal Platform",
  "license": "Apache-2.0",
  "require": {
    "php": ">=8.2",
    "symfony/yaml": "^7.1",
    "eftec/bladeone": "^4.19",
    "psr/container": "^2.0",
    "twig/twig": "^3.27",
    "league/commonmark": "^2.10"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.2",
    "friendsofphp/php-cs-fixer": "^3.95",
    "mockery/mockery": "^1.6",
    "symfony/panther": "^2.4"
  },
  "autoload": {
    "classmap": ["spp/"],
    "exclude-from-classmap": [
      "spp/modules/optional/",
      "spp/modules/contrib/"
    ]
  },
  "scripts": {
    "analyze": "vendor/bin/phpstan analyse -c phpstan.neon",
    "format": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php"
  }
}
